<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The width the game page's cover is decoded for. -->
    <dimen name="detail_cover_width">132dp</dimen>
    <!-- 2:3 at that width; only the TV layout reads it, the base value keeps lint's MissingDefaultResource quiet. -->
    <dimen name="detail_cover_height">198dp</dimen>
    <!-- The cover on the page held sideways (a handheld): 2:3, as tall as the lines and buttons beside it. A name of
         its own, since a value in values-land would outrank the TV's. -->
    <dimen name="detail_cover_land_width">156dp</dimen>
    <dimen name="detail_cover_land_height">234dp</dimen>
    <!-- The game page's rows line up with the text inside its stream settings panel. -->
    <dimen name="detail_row_padding">16dp</dimen>
</resources>
