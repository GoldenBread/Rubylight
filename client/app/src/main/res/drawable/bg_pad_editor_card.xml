<?xml version="1.0" encoding="utf-8"?>
<!-- The layout editor's option cards (the pointer touchpad's Mouse and Camera): Nightjar's glass, amber when chosen. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/night_glass_selectedfill" />
            <stroke android:width="?attr/nightjarFocusRingWidth" android:color="@color/night_glass_ring" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/night_glass_controlfill" />
            <stroke android:width="?attr/nightjarFocusRingWidth" android:color="@color/night_glass_ring" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/night_glass_selectedfill" />
            <stroke android:width="1dp" android:color="@color/night_glass_selectedrim" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/night_glass_controlrim" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/night_glass_controlfill" />
        </shape>
    </item>
</selector>
