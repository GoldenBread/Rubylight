-    LbqInitializeLinkedBlockingQueue(&decodeUnitQueue, 15);
+    LbqInitializeLinkedBlockingQueue(&decodeUnitQueue, decodeUnitQueueBound);
 
     nextFrameNumber = 1;
     startFrameNumber = 0;
