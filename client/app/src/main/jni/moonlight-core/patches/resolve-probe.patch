+#define TEST_PORT_PROBES_MAX 8
+#define TEST_PORT_PREFERENCE_MS 250
+
+// Tests the first TEST_PORT_PROBES_MAX addresses on the port at once, so a dead address costs no
+// more than one TEST_PORT_TIMEOUT_SEC in all, and returns the index of the most preferred one that
+// accepts the connection (earliest in getaddrinfo's order), or -1. Once an address answers, an
+// earlier one still trying gets TEST_PORT_PREFERENCE_MS more. The losing attempts are closed.
+static int probeAddresses(struct addrinfo* res, unsigned short port)
+{
+    SOCKET sockets[TEST_PORT_PROBES_MAX];
+    int state[TEST_PORT_PROBES_MAX]; // 0 trying, 1 answered, -1 failed
+    struct pollfd pfds[TEST_PORT_PROBES_MAX];
+    int polled[TEST_PORT_PROBES_MAX];
+    struct addrinfo* currentAddr;
+    LC_SOCKADDR probeAddr;
+    uint64_t deadline, answerDeadline = 0;
+    int count = 0;
+    int best = -1;
+    int i;
+
+    for (currentAddr = res; currentAddr != NULL && count < TEST_PORT_PROBES_MAX; currentAddr = currentAddr->ai_next) {
+        SOCKET s = createSocket(currentAddr->ai_family, SOCK_STREAM, IPPROTO_TCP, true);
+        sockets[count] = s;
+        state[count] = -1;
+        if (s != INVALID_SOCKET) {
+            memcpy(&probeAddr, currentAddr->ai_addr, currentAddr->ai_addrlen);
+            SET_PORT(&probeAddr, port);
+            if (connect(s, (struct sockaddr*)&probeAddr, (SOCKADDR_LEN)currentAddr->ai_addrlen) == 0) {
+                state[count] = 1;
+            }
+            else {
+                int err = (int)LastSocketError();
+                if (err == EWOULDBLOCK || err == EAGAIN || err == EINPROGRESS) {
+                    state[count] = 0;
+                }
+            }
+        }
+        count++;
+    }
+
+    deadline = PltGetMillis() + TEST_PORT_TIMEOUT_SEC * 1000;
+    for (;;) {
+        bool earlierTrying = false;
+        bool anyTrying = false;
+        uint64_t now, until;
+        int pollCount = 0;
+        int err;
+
+        best = -1;
+        for (i = 0; i < count; i++) {
+            if (state[i] == 1 && best < 0) {
+                best = i;
+            }
+            else if (state[i] == 0) {
+                anyTrying = true;
+                if (best < 0) {
+                    earlierTrying = true;
+                }
+            }
+        }
+        if ((best >= 0 && !earlierTrying) || !anyTrying) {
+            break;
+        }
+
+        now = PltGetMillis();
+        if (best >= 0 && answerDeadline == 0) {
+            answerDeadline = now + TEST_PORT_PREFERENCE_MS;
+        }
+        until = (best >= 0 && answerDeadline < deadline) ? answerDeadline : deadline;
+        if (now >= until) {
+            break;
+        }
+
+        for (i = 0; i < count; i++) {
+            if (state[i] == 0) {
+                pfds[pollCount].fd = sockets[i];
+                pfds[pollCount].events = POLLOUT;
+                pfds[pollCount].revents = 0;
+                polled[pollCount] = i;
+                pollCount++;
+            }
+        }
+        err = pollSockets(pfds, pollCount, (int)(until - now));
+        if (err < 0) {
+            Limelog("pollSockets() failed: %d\n", (int)LastSocketError());
+            break;
+        }
+        for (i = 0; i < pollCount; i++) {
+            if (pfds[i].revents != 0) {
+                int soError = 0;
+                SOCKADDR_LEN len = sizeof(soError);
+                getsockopt(sockets[polled[i]], SOL_SOCKET, SO_ERROR, (char*)&soError, &len);
+                state[polled[i]] = (soError == 0 && !(pfds[i].revents & POLLERR)) ? 1 : -1;
+            }
+        }
+    }
+
+    for (i = 0; i < count; i++) {
+        if (sockets[i] != INVALID_SOCKET) {
+            closeSocket(sockets[i]);
+        }
+    }
+    if (best < 0) {
+        Limelog("No address answered on TCP port %u within %d seconds\n", port, TEST_PORT_TIMEOUT_SEC);
+    }
+    return best;
+}
