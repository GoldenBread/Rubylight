+// Tests every port of the first TEST_PORT_PROBES_MAX addresses at once (up to TEST_PORT_PORTS_MAX
+// ports), so dead addresses and ports cost no more than one TEST_PORT_TIMEOUT_SEC in all, and
+// returns the index of the most preferred address that accepts a connection on one of its ports
+// (earliest in getaddrinfo's order), or -1. Once an address answers, an earlier one still trying
+// gets TEST_PORT_PREFERENCE_MS more. The losing attempts are closed.
+int probeAddressPorts(struct addrinfo* res, const unsigned short* ports, int portCount)
+{
+    SOCKET sockets[TEST_PORT_PROBES_MAX * TEST_PORT_PORTS_MAX];
