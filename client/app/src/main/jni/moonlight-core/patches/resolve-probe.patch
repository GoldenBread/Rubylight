+    int owner[TEST_PORT_PROBES_MAX * TEST_PORT_PORTS_MAX]; // the address each attempt tests
+    struct pollfd pfds[TEST_PORT_PROBES_MAX * TEST_PORT_PORTS_MAX];
+    int polled[TEST_PORT_PROBES_MAX * TEST_PORT_PORTS_MAX];
+    struct addrinfo* currentAddr;
+    LC_SOCKADDR probeAddr;
+    uint64_t deadline, answerDeadline = 0;
+    int addressCount = 0;
+    int count = 0;
+    int best = -1;
+    int i, p;
+
+    if (portCount > TEST_PORT_PORTS_MAX) {
+        portCount = TEST_PORT_PORTS_MAX;
+    }
+    for (currentAddr = res; currentAddr != NULL && addressCount < TEST_PORT_PROBES_MAX; currentAddr = currentAddr->ai_next) {
+        for (p = 0; p < portCount; p++) {
+            SOCKET s = createSocket(currentAddr->ai_family, SOCK_STREAM, IPPROTO_TCP, true);
+            sockets[count] = s;
+            state[count] = -1;
+            owner[count] = addressCount;
+            if (s != INVALID_SOCKET) {
+                memcpy(&probeAddr, currentAddr->ai_addr, currentAddr->ai_addrlen);
+                SET_PORT(&probeAddr, ports[p]);
+                if (connect(s, (struct sockaddr*)&probeAddr, (SOCKADDR_LEN)currentAddr->ai_addrlen) == 0) {
+                    state[count] = 1;
+                }
+                else {
+                    int err = (int)LastSocketError();
+                    if (err == EWOULDBLOCK || err == EAGAIN || err == EINPROGRESS) {
+                        state[count] = 0;
+                    }
+                }
+            }
+            count++;
+        }
+        addressCount++;
+    }
+
+    deadline = PltGetMillis() + TEST_PORT_TIMEOUT_SEC * 1000;
+    for (;;) {
+        bool earlierTrying = false;
+        bool anyTrying = false;
+        uint64_t now, until;
+        int pollCount = 0;
+        int err;
+        int a;
+
+        best = -1;
+        for (a = 0; a < addressCount; a++) {
+            bool answered = false;
+            bool trying = false;
+            for (i = 0; i < count; i++) {
+                if (owner[i] == a) {
+                    answered = answered || state[i] == 1;
+                    trying = trying || state[i] == 0;
+                }
+            }
+            if (answered && best < 0) {
+                best = a;
+            }
+            else if (!answered && trying) {
+                anyTrying = true;
+                if (best < 0) {
+                    earlierTrying = true;
+                }
+            }
+        }
+        if ((best >= 0 && !earlierTrying) || !anyTrying) {
+            break;
+        }
+
+        now = PltGetMillis();
+        if (best >= 0 && answerDeadline == 0) {
+            answerDeadline = now + TEST_PORT_PREFERENCE_MS;
+        }
+        until = (best >= 0 && answerDeadline < deadline) ? answerDeadline : deadline;
+        if (now >= until) {
+            break;
+        }
+
+        for (i = 0; i < count; i++) {
+            if (state[i] == 0) {
+                pfds[pollCount].fd = sockets[i];
+                pfds[pollCount].events = POLLOUT;
+                pfds[pollCount].revents = 0;
+                polled[pollCount] = i;
+                pollCount++;
+            }
+        }
+        err = pollSockets(pfds, pollCount, (int)(until - now));
+        if (err < 0) {
+            Limelog("pollSockets() failed: %d\n", (int)LastSocketError());
+            break;
+        }
+        for (i = 0; i < pollCount; i++) {
+            if (pfds[i].revents != 0) {
+                int soError = 0;
+                SOCKADDR_LEN len = sizeof(soError);
+                getsockopt(sockets[polled[i]], SOL_SOCKET, SO_ERROR, (char*)&soError, &len);
+                state[polled[i]] = (soError == 0 && !(pfds[i].revents & POLLERR)) ? 1 : -1;
+            }
+        }
+    }
+
+    for (i = 0; i < count; i++) {
+        if (sockets[i] != INVALID_SOCKET) {
+            closeSocket(sockets[i]);
+        }
+    }
+    if (best < 0) {
+        Limelog("No address answered on its %d TCP test port(s) within %d seconds\n", portCount, TEST_PORT_TIMEOUT_SEC);
+    }
+    return best;
+}
