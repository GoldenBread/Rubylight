{
  "rubylight-command-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|write_file|edit_file|read_file",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/guard_commands.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "rubylight-gpu-hang-watch": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/watch_gpu_hang.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
