// Packed 4:4:4, version 1 (client/protocol/core/src/packed444.rs): a BGRX picture's full-
// resolution YCbCr written as one NV12 picture of twice the padded height. The codes are those
// of the Windows host's `lumaCode` and `chromaCode` (rust/windows/abi/src/shaders/color.hlsl).
//
// Both pictures are linear VA surfaces seen as buffers of 32-bit words. One invocation codes
// eight source pixels of a row, so every word it writes is its own:
//   luma rows 0..H        the eight luma codes (two words)
//   luma row H + y        the four odd pixels' Cb at x0 / 2, their Cr at W / 2 + x0 / 2
//   chroma row y          the four even pixels' Cb, Cr pairs (two words)
// with W and H the padded width and height. Source pixels past the picture repeat its edge.
//
// Rebuild pack.spv after a change: glslc --target-env=vulkan1.2 -O pack.comp -o pack.spv
#version 450
layout(local_size_x = 8, local_size_y = 8) in;

layout(std430, set = 0, binding = 0) readonly buffer Source { uint source[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Target { uint target[]; };

layout(push_constant) uniform Parameters {
    uint width;          // the picture
    uint height;
    uint sourcePitch;    // words per source row
    uint targetPitch;    // words per target row, both planes
    uint paddedWidth;
    uint paddedHeight;
    uint chromaOffset;   // the target's chroma plane, in words
    uint colorMatrix;    // 0 BT.601, 1 BT.709, 2 BT.2020
    uint fullRange;
} p;

vec3 weights() {
    return p.colorMatrix == 2u ? vec3(0.2627, 0.6780, 0.0593)
         : p.colorMatrix == 0u ? vec3(0.299, 0.587, 0.114)
                               : vec3(0.2126, 0.7152, 0.0722);
}

uint lumaCode(vec3 rgb) {
    float y = dot(rgb, weights());
    return uint(floor(clamp(p.fullRange != 0u ? 255.0 * y : 16.0 + 219.0 * y, 0.0, 255.0) + 0.5));
}

uvec2 chromaCode(vec3 rgb) {
    vec3 k = weights();
    float y = dot(rgb, k);
    vec2 uv = vec2((rgb.b - y) / (2.0 * (1.0 - k.b)), (rgb.r - y) / (2.0 * (1.0 - k.r)));
    return uvec2(floor(clamp(128.0 + (p.fullRange != 0u ? 255.0 : 224.0) * uv, 0.0, 255.0) + 0.5));
}

vec3 rgbAt(uint x, uint y) {
    uint word = source[min(y, p.height - 1u) * p.sourcePitch + min(x, p.width - 1u)];
    // BGRX in memory: blue in the lowest byte.
    return vec3((word >> 16) & 255u, (word >> 8) & 255u, word & 255u) / 255.0;
}

uint bytes(uint a, uint b, uint c, uint d) {
    return a | (b << 8) | (c << 16) | (d << 24);
}

void main() {
    uint x0 = gl_GlobalInvocationID.x * 8u;
    uint y = gl_GlobalInvocationID.y;
    if (x0 >= p.paddedWidth || y >= p.paddedHeight) return;
    uint luma[8];
    uvec2 chroma[8];
    for (uint i = 0u; i < 8u; ++i) {
        vec3 rgb = rgbAt(x0 + i, y);
        luma[i] = lumaCode(rgb);
        chroma[i] = chromaCode(rgb);
    }
    uint row = y * p.targetPitch + x0 / 4u;
    target[row] = bytes(luma[0], luma[1], luma[2], luma[3]);
    target[row + 1u] = bytes(luma[4], luma[5], luma[6], luma[7]);
    uint lower = (p.paddedHeight + y) * p.targetPitch;
    target[lower + x0 / 8u] = bytes(chroma[1].x, chroma[3].x, chroma[5].x, chroma[7].x);
    target[lower + (p.paddedWidth / 2u + x0 / 2u) / 4u] =
        bytes(chroma[1].y, chroma[3].y, chroma[5].y, chroma[7].y);
    uint pairs = p.chromaOffset + y * p.targetPitch + x0 / 4u;
    target[pairs] = bytes(chroma[0].x, chroma[0].y, chroma[2].x, chroma[2].y);
    target[pairs + 1u] = bytes(chroma[4].x, chroma[4].y, chroma[6].x, chroma[6].y);
}
