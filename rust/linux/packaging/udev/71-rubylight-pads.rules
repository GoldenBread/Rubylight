# Gives the signed-in user's games the input devices of the controllers Rubylight emulates
# (rust/linux/io/src/input/hid_pad.rs and uhid_pad.rs name each `rubylight-<pid>/<kind><slot>`):
# the kernel's PlayStation, Nintendo and Steam drivers make a motion-sensor device (and a
# touchpad) beside the gamepad, and only the gamepad gets the seat's access by default. Install with
#   sudo install -m 644 71-rubylight-pads.rules /etc/udev/rules.d/ && sudo udevadm control --reload
SUBSYSTEM=="input", ATTRS{phys}=="rubylight-*", TAG+="uaccess"
