# Rubylight's host for one user: it streams their desktop while it is on the PC's screen (the
# desktop through the portal, games inside a gamescope of their own), and otherwise the screen
# itself through the KMS broker (rubylight-kms.socket): the login screen, or another user's
# session, with Desktop the only app. It is a user unit, started with the user's service
# manager: at boot with linger, else at their first sign-in (an SSH one too). It finds the
# desktop's display in the user manager once the desktop has started, and goes on when they
# sign out; without linger the user manager stops it with their last session.
#   systemctl --user enable --now rubylight.service
#   loginctl enable-linger            (to stream the login screen after boot)
# Its profile (settings, pairings, logs) is ~/.config/rubylight. The web console is on
# https://localhost:47990 (the port is `port` + 1 in sunshine.conf; the default `port` is 47989).
[Unit]
Description=Rubylight game-streaming host
Documentation=https://github.com/RamazanKara/Rubylight
After=pipewire.service
Wants=pipewire.service

[Service]
Type=simple
# The tray icon goes in the desktop's system tray (a StatusNotifierItem), once it runs; the
# `system_tray` setting turns it off.
ExecStart=/usr/bin/butterpollo
Environment=RUST_LOG=info
# "Restart host" in the console exits with 75 (sysexits EX_TEMPFAIL) under systemd, which
# Restart=on-failure answers; a stop (SIGTERM) or a clean exit leaves the unit stopped.
Restart=on-failure
RestartSec=2
# The host finishes its own shutdown within 17 s (game files, display, ports), then systemd
# ends what is left (a game, gamescope).
TimeoutStopSec=25
KillMode=mixed

[Install]
WantedBy=default.target
